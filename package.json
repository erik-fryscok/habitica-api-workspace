{
  "name": "habitica-api-workspace",
  "version": "0.1.0",
  "description": "Unofficial tools and generated API documentation for Habitica.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "generate": "node scripts/generate-habitica-openapi.mjs",
    "validate": "node scripts/validate-task-payload.mjs",
    "check": "node scripts/check-repository.mjs",
    "lint:openapi": "redocly lint openapi/habitica.openapi.json",
    "test": "npm run check && npm run lint:openapi && node --test"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.0",
    "yaml": "^2.8.1"
  }
}
